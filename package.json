{
  "name": "animal-personality-static",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "codes": "node scripts/generate-codes.mjs",
    "pack": "node scripts/package.mjs",
    "build:demo": "tsc --noEmit && vite build --mode demo && node scripts/demo-config.mjs",
    "build:edgeone": "node scripts/prepare-edgeone.mjs && npm run build && node scripts/finalize-edgeone.mjs",
    "build:pages": "node scripts/prepare-registry.mjs && npm run build && node scripts/finalize-pages.mjs",
    "build:cloudflare": "npm run build:pages && node scripts/finalize-cloudflare.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "esbuild": "0.27.7",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
